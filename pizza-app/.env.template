# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Optional: the Dash0 dataset to send telemetry to. Defaults to "default"
# if left unset.
DASH0_DATASET=default

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
